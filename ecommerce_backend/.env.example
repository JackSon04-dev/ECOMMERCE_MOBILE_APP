# ==========================================
# SERVER CONFIGURATION
# ngrok http --domain=<your-ngrok-domain>.ngrok-free.app 5000
# ==========================================
PORT=5000
# PUBLIC_BACKEND=https://<your-ngrok-domain>.ngrok-free.app
PUBLIC_BACKEND=https://your-domain.com


# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/authdb

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# CLOUDINARY MEDIA STORAGE
# ==========================================
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ==========================================
# VNPAY SANDBOX INTEGRATION
# ==========================================
# Test Card Info:
# Số thẻ: 9704198526191432198
# Tên: NGUYEN VAN A
# Ngày: 07/15 | OTP: 123456
# ==========================================
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_RETURN_URL=https://your-domain.com/api/payment/vnpay_return
VNP_IPN_URL=https://your-domain.com/api/payment/vnpay_ipn

# ==========================================
# ZALOPAY SANDBOX INTEGRATION
# ==========================================
ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://your-domain.com/api/payment/zalopay_callback

# ==========================================
# PAYOS INTEGRATION (VietQR)
# ==========================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=https://your-domain.com/api/payment/payos_return
PAYOS_CANCEL_URL=https://your-domain.com/api/payment/payos_return

# ==========================================
# REDIS CONFIGURATION (External URL for Local Dev)
# ==========================================
REDIS_URL=rediss://localhost

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_SENSITIVE_MAX=20

#
GEMINI_API_KEY=your_gemini_api_key
